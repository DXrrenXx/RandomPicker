<Page
    x:Class="RandomPicker.Views.ManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RandomPicker.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <MenuFlyout x:Name="ClassFlyout">
            <MenuFlyoutItem Text="重命名班级" Click="RenameClass_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8AC;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="删除班级" Click="DeleteClass_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <MenuFlyout x:Name="StudentFlyout">
            <MenuFlyoutItem Text="重命名" Click="RenameStudent_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8AC;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="删除" Click="DeleteStudentMenu_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid RowSpacing="12" Padding="24,8,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- WinUI 3 操作反馈条 -->
        <InfoBar x:Name="Feedback" IsOpen="False" Margin="0,8,0,0"/>

        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Background="Transparent"
                    HorizontalAlignment="Left" IsOpen="False">
            <AppBarButton Label="新建班级" Click="NewClass_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE710;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="导入 TXT 名单" Click="ImportTxt_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ExportBtn" Label="导出名单" Click="ExportTxt_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE792;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton x:Name="RenameClassBtn" Label="重命名班级" Click="RenameClass_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8AC;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="DeleteClassBtn" Label="删除班级" Click="DeleteClass_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 班级列表 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="班级" Margin="12,8,0,4" FontWeight="SemiBold" FontSize="14"/>
                    <ListView x:Name="ClassList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="ClassList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ClassInfo">
                                <Grid Background="Transparent" Height="36" RightTapped="ClassItem_RightTapped">
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" Margin="12,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 名单列表 -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="12,8,8,4">
                        <TextBlock x:Name="StudentHeader" Text="名单" FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button x:Name="AddStudentBtn" Click="AddStudents_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8FA;" FontSize="14"/>
                                    <TextBlock Text="添加同学"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeleteStudentBtn" Click="DeleteStudentBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    <TextBlock Text="删除选中"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="StudentList" Grid.Row="1" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid Background="Transparent" Height="36" RightTapped="StudentItem_RightTapped">
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center" Margin="12,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
