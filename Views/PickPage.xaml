<Page
    x:Class="RandomPicker.Views.PickPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Grid RowSpacing="8" Padding="0,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 当前班级 -->
        <TextBlock x:Name="ClassTitle" HorizontalAlignment="Center" FontSize="16"
                   FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="0,4,0,0"/>

        <!-- 大字姓名窗口 -->
        <Grid Grid.Row="1" Padding="32,0">
            <Border x:Name="NameCard"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="16"
                    Padding="72,48" MinWidth="420" MinHeight="220"
                    RenderTransformOrigin="0.5,0.5">
                <Viewbox Stretch="Uniform" MaxHeight="320">
                    <TextBlock x:Name="NameText" Text="？" FontSize="140" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </Viewbox>
            </Border>
        </Grid>

        <!-- 开始 / 停止 -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="StartBtn" Height="60" MinWidth="280" Click="StartBtn_Click"
                    Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Space"/>
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon x:Name="BtnIcon" Glyph="&#xE768;" FontSize="18"/>
                    <TextBlock x:Name="BtnText" Text="开始随机" FontSize="19"/>
                </StackPanel>
            </Button>
            <TextBlock Text="按空格键也可开始 / 停止" FontSize="12" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </StackPanel>

        <!-- 名单为空时的提示 -->
        <TextBlock Grid.Row="3" x:Name="EmptyHint" TextWrapping="Wrap" TextAlignment="Center"
                   Visibility="Collapsed" Margin="0,4,0,16" MaxWidth="480"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</Page>
